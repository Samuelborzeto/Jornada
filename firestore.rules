rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid}/profiles/{pid} { allow read, write: if isOwner(uid); }
    match /users/{uid}/meta/house { allow read, write: if isOwner(uid); }
    match /users/{uid}/meta/plan {
      allow read, delete: if isOwner(uid);
      allow create, update: if false;
    }
    match /pushSchedules/{uid} { allow read, write: if isOwner(uid); }
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow read, update, delete: if false;
    }

    match /families/{fid} {
      function fam() { return get(/databases/$(database)/documents/families/$(fid)).data; }
      function inFam() {
        return signedIn() && (
          fam().createdBy == request.auth.uid ||
          fam().get('gate', false) == false ||
          (fam().get('approved', {}).get(request.auth.uid, false) == true &&
           fam().get('removed', {}).get(request.auth.uid, false) == false));
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{mid} {
        allow read: if inFam();
        allow write: if signedIn() && mid.matches(request.auth.uid + '_.*');
      }
      match /duos/{did} {
        allow read: if inFam();
        allow create: if inFam() && request.resource.data.createdBy == request.auth.uid;
        allow update: if inFam() && request.auth.uid in resource.data.get('uids', []);
        allow delete: if inFam() && resource.data.createdBy == request.auth.uid;
      }
      match /tasks/{tid} {
        allow read: if inFam();
        allow create: if inFam() && request.resource.data.createdBy == request.auth.uid && request.auth.uid in request.resource.data.uids;
        allow update: if inFam() && request.auth.uid in resource.data.get('uids', []);
        allow delete: if inFam() && resource.data.createdBy == request.auth.uid;
      }
    }
  }
}
